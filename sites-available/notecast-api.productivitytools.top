server {
        listen 80;
        listen [::]:80;

        server_name notecast-api.productivitytools.top;

        location / {
                # GKE Service LoadBalancer (static IP notecast-webapi-lb, us-central1)
                proxy_pass http://34.45.201.70:80;

                proxy_set_header Host $http_host;
                proxy_set_header X-Real-IP $remote_addr;
                proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto $scheme;
        }
}
